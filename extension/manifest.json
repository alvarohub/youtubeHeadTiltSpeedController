{
  "manifest_version": 3,
  "name": "Head Tilt Controller for YouTube",
  "short_name": "TiltControl",
  "version": "0.1.0",
  "description": "Control YouTube playback with head tilt: lean left/right to slow down or speed up, tilt more to skip. All processing is local — no video ever leaves your device.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["vendor/face_mesh/face_mesh.js", "content.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/face_mesh/*"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "permissions": ["storage"]
}
